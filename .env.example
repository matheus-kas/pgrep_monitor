# Copie este arquivo para .env e preencha os valores.
# O .env NÃO deve ser versionado (já está no .gitignore).

# ---------- Banco de dados ----------
# Senhas do PostgreSQL master e réplica (host/usuário/porta ficam no config.ini).
MASTER_DB_PASSWORD=
REPLICA_DB_PASSWORD=

# ---------- Telegram ----------
# Crie um bot com @BotFather e pegue o token.
# Para descobrir o chat_id: envie uma mensagem ao bot e acesse
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Opcional: chat_id "fixo" (ex.: admin) que sempre recebe, além dos inscritos.
# Pode deixar em branco e usar apenas a auto-inscrição via senha abaixo.
TELEGRAM_CHAT_ID=
# Senha que a pessoa envia ao bot (/start -> senha) para se auto-inscrever
# e passar a receber os status. Se em branco, a auto-inscrição fica desligada.
TELEGRAM_SUBSCRIBE_PASSWORD=

# ---------- E-mail (SMTP) ----------
# Exemplo Gmail: SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_USE_TLS=true
# (use uma "senha de app", não a senha normal da conta)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Vários destinatários separados por vírgula
EMAIL_TO=
